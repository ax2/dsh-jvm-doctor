{
  "name": "dsh-jvm-doctor",
  "version": "0.1.5",
  "description": "DSH plugin: offline JVM production-report diagnostics — thread dumps with Java-level deadlock cycles, GC-log pause percentiles, Maven/Gradle dependency conflicts, exception chains and Spring config diffs. Never touches a running process: no jcmd, no jstack, no attach, no network.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "deterministic",
    "offline",
    "local-first",
    "no-network",
    "read-only",
    "jvm",
    "java",
    "jdk",
    "thread-dump",
    "jstack",
    "deadlock",
    "gc-log",
    "garbage-collection",
    "gc-pause",
    "dependency-conflict",
    "maven",
    "gradle",
    "stack-trace",
    "exception-chain",
    "spring",
    "spring-boot",
    "application-yml",
    "diagnostics",
    "production-diagnostics",
    "troubleshooting",
    "sre"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax2/dsh-jvm-doctor.git"
  },
  "homepage": "https://zicode.com/software/",
  "bugs": {
    "url": "https://github.com/ax2/dsh-jvm-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
